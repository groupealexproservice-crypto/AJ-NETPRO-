# ── Application ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public origin used in canonical URLs, hreflang, sitemap and CSRF checks (no trailing slash).
PUBLIC_URL=https://www.example.com
# Signs session cookies. At least 32 random characters:  openssl rand -base64 48
APP_SECRET=
# MySQL 8 / MariaDB 10.6+.  On Hostinger the app connects to 127.0.0.1:3306.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/database

# ── First administrator (created at start-up only if no administrator exists) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=            # 12+ characters, letters and digits. Change it after the first sign-in, then remove it from the environment.

# ── Documents shared with clients ──────────────────────────────
# Directory OUTSIDE the web root and outside the deployed build, persisted between deployments.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=15

# ── Integrations (all optional; nothing is sent while a URL is empty) ──
# Each webhook receives signed JSON: header X-Aurex-Signature = HMAC-SHA256(body, secret), header X-Aurex-Event.
CRM_WEBHOOK_URL=           # new leads: diagnostic, quote, consultation, contact
CRM_WEBHOOK_SECRET=
NOTIFY_WEBHOOK_URL=        # internal alerts (e-mail relay, Slack, Zapier, Make…)
NOTIFY_WEBHOOK_SECRET=
MARKETING_WEBHOOK_URL=     # newsletter subscriptions and unsubscriptions, with consent date
MARKETING_WEBHOOK_SECRET=
CALENDAR_BOOKING_URL=      # team booking page (Google Calendar, Calendly, Outlook…). Appointments stay "to confirm" until connected.

# ── Coordonnées publiques (affichées seulement si renseignées ; rien n'est inventé) ──
COMPANY_LEGAL_NAME=        # raison sociale, ex. : AUREX Solutions inc.
COMPANY_NEQ=               # numéro d'entreprise du Québec (NEQ)
COMPANY_EMAIL=             # courriel public de contact
COMPANY_PHONE=             # téléphone public
COMPANY_STREET=            # adresse civique (Montréal, QC est déjà indiqué)
COMPANY_POSTAL_CODE=
COMPANY_LINKEDIN_URL=
PRIVACY_OFFICER_NAME=      # responsable de la protection des renseignements personnels (Loi 25)
PRIVACY_OFFICER_EMAIL=

# ── Conseiller IA (optionnel) ──────────────────────────────────
# Sans clé, le conseiller répond à partir du contenu du site ("mode connaissances"). Avec une clé Anthropic, il utilise un modèle de langage,
# toujours guidé par le contenu AUREX et des règles strictes. Les courriels et numéros sont masqués avant tout envoi.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# ── Tests only ─────────────────────────────────────────────────
# TEST_DATABASE_URL=mysql://user:password@127.0.0.1:3306/aurex_test
# DEMO_PASSWORD=            # password for `npm run db:seed:demo` accounts (never use in production)
